# ============================================================
# print-agent — servicio de impresión genérico.
# Casi todo se configura desde la INTERFAZ WEB:  http://IP_DEL_HOST:8000
# (impresoras y clientes/tokens se gestionan ahí, no aquí).
#
# Estos valores son solo la SEMILLA de la PRIMERA ejecución, para que arranque
# con una impresora y un token ya listos. Después manda /data/settings.json.
# Puedes dejar este archivo casi vacío y configurar todo por la web.
# ============================================================

# --- Protección de la interfaz web (opcional, recomendado) ---
ADMIN_USER=admin
ADMIN_PASSWORD=                 # si lo defines, la web pedirá usuario/clave

# --- Impresora semilla (opcional) ---
# Si dejas SMB_HOST vacío, arranca sin impresoras y las añades por la web.
PRINTER_NAME=principal
SMB_HOST=                       # IP del PC Windows que comparte la impresora
SMB_SHARE=                      # nombre EXACTO del recurso compartido
SMB_USER=                       # usuario Windows (vacío = comparte abierta)
SMB_PASS=
SMB_DOMAIN=WORKGROUP
#SMB_IP=192.168.1.50            # opcional: IP explícita si el nombre no resuelve
PRINT_MODE=escpos               # escpos (RAW / Generic Text Only) o text
PAPER_WIDTH_CHARS=48            # 80mm = 48
CODEPAGE=cp850                  # acentos en español
CUT_PAPER=true
OPEN_DRAWER=false

# --- Cliente/token semilla (opcional) ---
# Si defines PRINT_TOKEN, se crea un cliente con ese token. Si no, el servicio
# arranca abierto en la red local (puedes añadir clientes luego por la web).
CLIENT_NAME=sistema
PRINT_TOKEN=

# --- Cola y reintentos (globales) ---
RETRY_DELAY_SECONDS=15          # espera entre reintentos si la impresora no responde
MAX_ATTEMPTS=0                  # 0 = reintentar para siempre (no se pierde el trabajo)
KEEP_DONE=200                   # cuántos impresos conservar en el historial
